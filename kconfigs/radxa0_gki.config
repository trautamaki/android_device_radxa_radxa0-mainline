#
# Generic drivers/frameworks
#
CONFIG_COMMON_CLK_PWM=y
CONFIG_REGULATOR_PWM=y
CONFIG_PWRSEQ_EMMC=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_USB_DWC2=y
CONFIG_LEDS_GPIO=y

#
# Networking
#
CONFIG_REALTEK_PHY=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y

#
# WLAN
#
CONFIG_WLAN_VENDOR_BROADCOM=y
#
# Amlogic
#
CONFIG_ARCH_MESON=y
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y

#
# Amlogic drivers as modules
#
# core
CONFIG_MESON_SM=y
CONFIG_RESET_MESON=y
CONFIG_MESON_IRQ_GPIO=y

# clocks
CONFIG_COMMON_CLK_MESON_REGMAP=y
CONFIG_COMMON_CLK_MESON_DUALDIV=y
CONFIG_COMMON_CLK_MESON_MPLL=y
CONFIG_COMMON_CLK_MESON_PHASE=y
CONFIG_COMMON_CLK_MESON_PLL=y
CONFIG_COMMON_CLK_MESON_SCLK_DIV=y
CONFIG_COMMON_CLK_MESON_VID_PLL_DIV=y
CONFIG_COMMON_CLK_MESON_AO_CLKC=y
CONFIG_COMMON_CLK_MESON_EE_CLKC=y
CONFIG_COMMON_CLK_MESON_CPU_DYNDIV=y
CONFIG_COMMON_CLK_GXBB=y
CONFIG_COMMON_CLK_AXG=y
CONFIG_COMMON_CLK_G12A=y

# PHY
CONFIG_PHY_MESON8B_USB2=y
CONFIG_PHY_MESON_GXL_USB2=y
CONFIG_PHY_MESON_G12A_USB2=y
CONFIG_PHY_MESON_G12A_USB3_PCIE=y
CONFIG_PHY_MESON_AXG_PCIE=y
CONFIG_PHY_MESON_AXG_MIPI_PCIE_ANALOG=y

# peripherals
CONFIG_I2C_MESON=y
CONFIG_MMC_MESON_GX=y
CONFIG_HW_RANDOM_MESON=y
CONFIG_USB_DWC3_MESON_G12A=y
CONFIG_MESON_SARADC=y
CONFIG_SPI_MESON_SPICC=y
CONFIG_SPI_MESON_SPIFC=y
CONFIG_PCI_MESON=y
CONFIG_DWMAC_MESON=y
CONFIG_MDIO_BUS_MUX_MESON_G12A=y
CONFIG_MESON_GXL_PHY=y
CONFIG_PINCTRL_MESON=y
CONFIG_PINCTRL_MESON_GXBB=y
CONFIG_PINCTRL_MESON_GXL=y
CONFIG_PINCTRL_MESON_AXG=y
CONFIG_PINCTRL_MESON_AXG_PMX=y
CONFIG_PINCTRL_MESON_G12A=y
CONFIG_MESON_GXBB_WATCHDOG=y
CONFIG_MESON_WATCHDOG=y
CONFIG_PWM_MESON=y
CONFIG_IR_MESON=y
CONFIG_MFD_KHADAS_MCU=y
CONFIG_KHADAS_MCU_FAN_THERMAL=y
CONFIG_AMLOGIC_THERMAL=y

# sound
CONFIG_SND_MESON_AXG_SOUND_CARD=y
CONFIG_SND_MESON_GX_SOUND_CARD=y
CONFIG_SND_MESON_G12A_TOHDMITX=y

# display / video
CONFIG_DRM_MESON=y
CONFIG_DRM_MESON_DW_HDMI=y
CONFIG_DRM_DW_HDMI=y
CONFIG_DRM_DW_HDMI_AHB_AUDIO=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
CONFIG_DRM_DW_HDMI_CEC=y
CONFIG_CEC_MESON_AO=y
CONFIG_CEC_MESON_G12A_AO=y
CONFIG_VIDEO_MESON_GE2D=y

# SoC drivers
CONFIG_MESON_CANVAS=y
CONFIG_MESON_CLK_MEASURE=y
CONFIG_MESON_EE_PM_DOMAINS=y
CONFIG_MESON_SECURE_PM_DOMAINS=y

#
# Amlogic drivers disable
#
# 32-bit SoC drivers

CONFIG_MESON6_TIMER=n
CONFIG_MESON_MX_SOCINFO=n
# only needed by DRM on S805X
CONFIG_MESON_GX_SOCINFO=n

#
# Debug / Testing
#
# devtmpfs needed for buildroot/udev module loading, serial console
#CONFIG_DEVTMPFS=y
#CONFIG_DEVTMPFS_MOUNT=y
# debug/testing with FB console
#CONFIG_DRM_KMS_FB_HELPER=y
#CONFIG_DRM_FBDEV_EMULATION=y
#CONFIG_FB=y
#CONFIG_VT=y
#CONFIG_FRAMEBUFFER_CONSOLE=y
#CONFIG_LOGO=y

CONFIG_CMDLINE_PARTITION=y
CONFIG_PARTITION_ADVANCED=y
